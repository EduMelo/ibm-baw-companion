{
  "name": "IBM BAW Companion",
  "version": "1.0",
  "description": "Extensão companheira para o IBM BAW",
  "manifest_version": 3,
  "permissions": ["tabs", "storage", "scripting", "webNavigation"],
  "host_permissions": ["*://www.bpm.ibmcloud.com/*", "https://*.bpm.ibmcloud.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "images/logo/baw-companion-16.png",
    "48": "images/logo/baw-companion-48.png",
    "128": "images/logo/baw-companion-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ppsa-br.bpm.ibmcloud.com/bpm/dev/ProcessCenter/*",
        "https://ppsa-br.bpm.ibmcloud.com/bpm/dev/WebPD/*"
      ],
      "js": ["app.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ppsa-br.bpm.ibmcloud.com/bpm/dev/WebPD/*"
      ],
      "js": ["sortTreeItems.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ppsa-br.bpm.ibmcloud.com/bpm/dev/ProcessInspector/*",
        "https://ppsa-br.bpm.ibmcloud.com/bpm/test/ProcessInspector/*",
        "https://ppsa-br.bpm.ibmcloud.com/bpm/run/ProcessInspector/*"
      ],
      "js": ["processInspector.js"],
      "css": ["processInspector.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
